+    assert out[2]['candidates'][0]['player_foot_support_h'] <= bt.DORMANT_PLAYER_SUPPORT_H
+    assert 'touch' not in out[2] and 'scorer' not in out[2]
+
+def test_dormant_candidate_outside_player_support_still_cannot_hijack():
